# Environment Variables Template
# 复制此文件为 .env.local 并填入实际的值

# 阿里云 RDS PostgreSQL 数据库
# 本地开发使用外网地址，ECS 部署使用内网地址
DATABASE_URL=postgresql://用户名:密码@RDS地址:5432/ecosystem

# DeepSeek AI（慧慧AI助手）
# 注意：变量名必须以 NEXT_PUBLIC_ 开头，否则代码读取不到
NEXT_PUBLIC_DEEPSEEK_API_KEY=your-deepseek-api-key
NEXT_PUBLIC_DEEPSEEK_API_KEY_MANAGER=your-deepseek-api-key-for-manager
NEXT_PUBLIC_DEEPSEEK_API_KEY_MEMBER=your-deepseek-api-key-for-member

# 博查联网搜索（可选，不配置则跳过联网搜索）
BOCHA_API_KEY=your-bocha-api-key

# 天眼查 Open API（国内服务器直连，无需代理）
TIANYANCHA_TOKEN=your-tianyancha-token

# 天眼查代理（仅海外服务器部署时需要，阿里云ECS无需配置）
TIANYANCHA_PROXY_BASE=

# 阿里云 RAM 用户 AccessKey（短信服务 + OCR文字识别 共用同一对密钥）
# 建议创建专门的 RAM 用户（而不是主账号 AccessKey），并授予以下两条系统权限策略：
#   - AliyunDysmsFullAccess（短信服务）
#   - AliyunOCRFullAccess（文字识别OCR，用于"上传文档自动填表"功能）
ALIYUN_ACCESS_KEY_ID=your-access-key-id
ALIYUN_ACCESS_KEY_SECRET=your-access-key-secret

# 阿里云短信服务（手机号注册验证码）
# 控制台：https://dysms.console.aliyun.com/
# 1. 申请短信签名（Sign Name）
# 2. 申请短信模板（Template），模板内容需包含 ${code} 变量，例如：
#    您的验证码为${code}，5分钟内有效，请勿泄露给他人。
# 未配置这2项时，验证码会打印到服务器日志用于本地调试，不会真实发送短信
ALIYUN_SMS_SIGN_NAME=your-sms-sign-name
ALIYUN_SMS_TEMPLATE_CODE=your-template-code
